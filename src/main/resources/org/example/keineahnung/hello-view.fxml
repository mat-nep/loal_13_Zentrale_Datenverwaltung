<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="MainWindowController">

    <Label text="Medienverwaltung"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Alle Medien"/>
        <Button text="Bücher"/>
        <Button text="Spiele"/>
        <Button text="Filme"/>
        <Button text="Statistik"/>
    </HBox>

    <Separator/>

    <Label text="Medium hinzufügen oder bearbeiten"/>

    <TextField fx:id="txtTitle" promptText="Titel"/>
    <TextField fx:id="txtGenre" promptText="Genre"/>
    <TextField fx:id="txtYear" promptText="Erscheinungsjahr"/>
    <TextField fx:id="txtRating" promptText="Bewertung"/>

    <ComboBox fx:id="cmbType" promptText="Medientyp auswählen"/>

    <TextField fx:id="txtExtra"
               promptText="Autor, Plattform oder Regisseur"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Hinzufügen"/>
        <Button text="Bearbeiten"/>
        <Button text="Löschen"/>
    </HBox>

    <Separator/>

    <Label text="Suche"/>

    <HBox spacing="10">
        <TextField fx:id="txtSearch" promptText="Titel suchen"
                   HBox.hgrow="ALWAYS"/>
        <Button text="Suchen"/>
        <Button text="Alle anzeigen"/>
    </HBox>

    <TableView fx:id="tableMedia" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" text="Titel" prefWidth="150"/>
            <TableColumn fx:id="colType" text="Typ" prefWidth="90"/>
            <TableColumn fx:id="colGenre" text="Genre" prefWidth="100"/>
            <TableColumn fx:id="colYear" text="Jahr" prefWidth="70"/>
            <TableColumn fx:id="colRating" text="Bewertung" prefWidth="90"/>
            <TableColumn fx:id="colExtra" text="Zusatzinformation" prefWidth="160"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Speichern"/>
        <Button text="Laden"/>
    </HBox>

</VBox>