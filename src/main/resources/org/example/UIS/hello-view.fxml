<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.keineahnung.HelloController">

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Medienverwaltung" />

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#filterAlleMedien" text="Alle Medien" />
        <Button onAction="#filterBücher" text="Bücher" />
        <Button onAction="#filterSpiele" text="Spiele" />
        <Button onAction="#filterFilme" text="Filme" />
    </HBox>

    <Separator />

    <Label text="Medium hinzufügen oder bearbeiten" />

    <TextField fx:id="txtTitle" promptText="Titel" />
    <TextField fx:id="txtGenre" promptText="Genre" />
    <TextField fx:id="txtYear" promptText="Erscheinungsjahr" />
    <TextField fx:id="txtRating" promptText="Bewertung" />

    <ComboBox fx:id="cmbType" promptText="Medientyp auswählen" />

    <TextField fx:id="txtExtra" promptText="Autor, Plattform oder Regisseur" />

    <HBox alignment="CENTER" spacing="10">
        <Button text="Hinzufügen" />
        <Button text="Bearbeiten" />
        <Button text="Löschen" />
    </HBox>

    <Separator />

    <Label text="Suche" />

    <HBox spacing="10">
        <TextField fx:id="txtSearch" promptText="Titel suchen" HBox.hgrow="ALWAYS" />
        <Button text="Suchen" onAction="#searchTitle"/>
        <Button text="Alle anzeigen" onAction="#resetSearchTitle"/>
    </HBox>

    <TableView fx:id="tableMedia" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" prefWidth="150" text="Titel" />
            <TableColumn fx:id="colType" prefWidth="90" text="Typ" />
            <TableColumn fx:id="colGenre" prefWidth="100" text="Genre" />
            <TableColumn fx:id="colYear" prefWidth="70" text="Jahr" />
            <TableColumn fx:id="colRating" prefWidth="90" text="Bewertung" />
            <TableColumn fx:id="colExtra" prefWidth="160" text="Zusatzinformation" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#save" text="Speichern" />
        <Button onAction="#load" text="Laden" />
    </HBox>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>

</VBox>
